# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# App
APP_URL=http://localhost:3000

# R2 Cloudflare
# Prefixed R2_FILES_ (not R2_) because @opennextjs/cloudflare reserves
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY globally for its own R2 cache-purge feature.
R2_FILES_ACCOUNT_ID=
R2_FILES_ACCESS_KEY_ID=
R2_FILES_SECRET_ACCESS_KEY=
