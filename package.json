{
	"name": "safe-screen",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply safe-screen --local",
		"db:migrate:remote": "wrangler d1 migrations apply safe-screen --remote",
		"db:studio": "drizzle-kit studio --config=drizzle.studio.config.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@hookform/resolvers": "^5.7.1",
		"@opennextjs/cloudflare": "^1.19.9",
		"better-auth": "^1.6.25",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "0.45.2",
		"lucide-react": "^1.28.0",
		"next": "16.2.11",
		"next-themes": "^0.4.6",
		"react": "^19.1.7",
		"react-dom": "^19.1.7",
		"react-hook-form": "^7.84.0",
		"shadcn": "^4.16.1",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"uuid": "^14.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20.19.43",
		"@types/react": "^19.1.7",
		"@types/react-dom": "^19.1.7",
		"better-sqlite3": "^13.0.2",
		"drizzle-kit": "0.31.10",
		"eslint": "^9",
		"eslint-config-next": "16.2.11",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4",
		"typescript": "^5.7.4",
		"wrangler": "^4.118.0"
	}
}
